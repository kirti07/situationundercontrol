{
  "name": "@suc/game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "size": "size-limit"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@fontsource/libre-caslon-text": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/special-elite": "5.3.0",
    "@fontsource/tiro-devanagari-hindi": "5.3.0",
    "@size-limit/file": "14.2.0",
    "size-limit": "14.2.0",
    "vite": "8.3.4"
  },
  "size-limit": [
    {
      "name": "home page JS",
      "path": "dist/assets/index-*.js",
      "limit": "25 kB"
    },
    {
      "name": "all JS",
      "path": "dist/assets/*.js",
      "limit": "60 kB"
    },
    {
      "name": "cockroach sprites",
      "path": [
        "dist/assets/roach-*.webp",
        "dist/assets/police-*.webp",
        "dist/assets/hazard-*.webp"
      ],
      "limit": "120 kB"
    },
    {
      "name": "media sprites",
      "path": [
        "dist/assets/media-run-*.webp",
        "dist/assets/police-*.webp",
        "dist/assets/hazard-fire-*.webp"
      ],
      "limit": "90 kB"
    },
    {
      "name": "public servant sprites",
      "path": [
        "dist/assets/servant-run-*.webp",
        "dist/assets/police-*.webp",
        "dist/assets/hazard-fire-*.webp"
      ],
      "limit": "90 kB"
    },
    {
      "name": "fonts",
      "path": "dist/assets/*.woff2",
      "limit": "260 kB"
    }
  ]
}
